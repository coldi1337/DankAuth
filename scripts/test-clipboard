#!/usr/bin/env python3
"""Check live Wayland copying with synthetic data; preserve previous text in memory."""
from pathlib import Path
import subprocess

repo = Path(__file__).resolve().parents[1]
paste = ['wl-paste', '--no-newline', '--type', 'text/plain']
saved = subprocess.run(paste, capture_output=True)
types = subprocess.run(['wl-paste', '--list-types'], capture_output=True)
if saved.returncode and types.returncode == 0 and types.stdout.strip():
    print('SKIP: clipboard has non-text content; leaving it untouched')
    raise SystemExit(0)
try:
    result = subprocess.run(['node', str(repo / 'tests/clipboard-live.mjs')], capture_output=True, text=True, timeout=8)
    if result.returncode:
        raise SystemExit('FAIL: live clipboard check\n' + result.stderr[-2000:])
    print(result.stdout.strip())
finally:
    # Do not overwrite content copied by another application during the test.
    current = subprocess.run(paste, capture_output=True)
    if current.returncode and saved.returncode == 0:
        flags = ['wl-copy', '--type', 'text/plain']
        if b'x-kde-passwordManagerHint' in types.stdout:
            flags.append('--sensitive')
        subprocess.run(flags, input=saved.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
